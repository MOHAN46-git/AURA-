# Grok (xAI) API Key: Primary LLM for goal compilation & semantic reasoning
# Get your API key from: https://console.x.ai/
GROK_API_KEY="your_grok_api_key_here"
XAI_API_KEY=""

# Gemini API Key: Optional alternative provider
GEMINI_API_KEY=""

# Google Workspace OAuth 2.0 (Gmail API & Google Calendar API)
# Configure credentials in Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Hackathon Demo Mode: Enables failure simulation and demo controls
AURA_DEMO_MODE=true

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"
