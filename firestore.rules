rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write access to workflows, tasks, and execution logs
    match /workflows/{workflowId} {
      allow read, write: if true;
    }
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    match /execution_logs/{logId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
